{
  "name": "@allspark-js/builder",
  "version": "1.0.0-alpha.2",
  "description": "Builder for typescript services.",
  "bin": {
    "allspark-builder": "bin/builder"
  },
  "keywords": [
    "js",
    "ts",
    "allspark",
    "builder"
  ],
  "author": "Andrew Cavalcante pacifico <andrewcpacifico@gmail.com>",
  "homepage": "https://github.com/andrewcpacifico/allspark-ts#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewcpacifico/allspark-ts.git"
  },
  "scripts": {
    "prepublishOnly": "yarn compile",
    "compile": "rm -rf ./dist && yarn g:tsc -p tsconfig.build.json && yarn copyFiles",
    "copyFiles": " cp -r ./{package.json,bin,config} dist/ && yarn g:copyfiles -u 1 \"./src/**/*@(.js|.d.ts)\" dist/lib && mv dist/lib/third-party dist/third-party",
    "test": "echo \"No tests\"",
    "test:unit:dev": "mocha test/unit/**/*.spec.ts --watch"
  },
  "bugs": {
    "url": "https://github.com/andrewcpacifico/allspark-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@types/chai": "^5.0.0",
    "@types/chai-as-promised": "^8.0.1",
    "@types/jest": "^29.5.13",
    "@types/jest-when": "^3.5.5",
    "@types/node": "^22.7.4",
    "@types/sinon-chai": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@zerollup/ts-transform-paths": "^1.7.18",
    "chai": "^5.1.1",
    "chai-as-promised": "^8.0.0",
    "eslint": "^9.11.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "jest": "^29.7.0",
    "jest-chain": "^1.1.6",
    "jest-extended": "^4.0.2",
    "jest-when": "^3.6.0",
    "nock": "^13.5.5",
    "nodemon": "^3.1.7",
    "sinon": "^19.0.2",
    "sinon-chai": "^4.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "ttypescript": "^1.5.15",
    "typescript": "^5.6.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@types/yargs": "^17.0.33"
  }
}
